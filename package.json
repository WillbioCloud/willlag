{
  "name": "willlag",
  "productName": "willLag",
  "version": "2.0.0",
  "description": "Otimizador local de latência para jogos online: TCP/IP, Wi-Fi USB, DNS e MTU — com backup e reversão de cada ajuste",
  "main": "public/electron.js",
  "homepage": "./",
  "private": true,
  "author": "willLag",
  "license": "MIT",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "dev": "npm run electron-dev",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron": "electron .",
    "electron-build": "npm run sync-catalog && npm run build && electron-builder",
    "test": "npm run test:main && npm run test:renderer",
    "test:main": "node --test \"test/*.test.js\"",
    "test:renderer": "cross-env CI=true react-scripts test --watchAll=false --env=jsdom",
    "test:watch": "react-scripts test",
    "sync-catalog": "node scripts/sync-tweak-catalog.js",
    "sync-catalog:check": "node scripts/sync-tweak-catalog.js --check",
    "verify": "npm run sync-catalog:check && npm test",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.willlag.app",
    "productName": "willLag",
    "artifactName": "willLag-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "recharts": "^2.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "react-icons": "^4.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
